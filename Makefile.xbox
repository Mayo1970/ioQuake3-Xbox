	$(CURDIR)/code/asm/snapvector.c 	$(wildcard $(CURDIR)/code/thirdparty/jpeg-9f/j*.c)

# nxdk supplies the Pentium III-safe ABI; XBOX is explicit so conditionals
# never depend on an incidental compiler macro.
NXDK_CFLAGS += -DXBOX -DIOQUAKE3_XBOX -DIOQUAKE3_XBOX_SHELL -DBOTLIB -DC_ONLY $(FLAVOR_DEFINES) -O2 -ffunction-sections -fno-exceptions 	-DUSE_INTERNAL_JPEG -I$(CURDIR)/code/thirdparty/jpeg-9f \
	-I/usr/src/nxdk/lib/net/lwip/src/include \
	-I/usr/src/nxdk/lib/net/lwip/src/include/compat/posix
NXDK_NET = y
NXDK_USB_ENABLE_HID = y
# nxdk's DEBUG=y build also writes D:\ioquake3.log; delete sys_xbox.obj when switching.
ifeq ($(DEBUG),y)
NXDK_CFLAGS += -DXBOX_DEBUG_LOG
endif

ifeq ($(FLAVOR),oa)
# OA music is Ogg Vorbis (32 kHz stereo); Q3 and TA ship WAV only. Decoder list as in the PS3 port.
XBOX_OGG_DIR = $(CURDIR)/code/thirdparty/libogg-1.3.6
XBOX_VORBIS_DIR = $(CURDIR)/code/thirdparty/libvorbis-1.3.7
XBOX_VORBIS_SRCS = \
	$(CURDIR)/code/client/snd_codec_ogg.c \
	$(XBOX_OGG_DIR)/src/bitwise.c $(XBOX_OGG_DIR)/src/framing.c \
	$(addprefix $(XBOX_VORBIS_DIR)/lib/, mdct.c block.c window.c synthesis.c info.c \
		floor0.c floor1.c res0.c mapping0.c registry.c codebook.c sharedbook.c \
		smallft.c vorbisfile.c analysis.c bitrate.c envelope.c lpc.c lsp.c psy.c)
SRCS += $(XBOX_VORBIS_SRCS)
NXDK_CFLAGS += -DUSE_CODEC_VORBIS
$(patsubst %.c,%.obj,$(XBOX_VORBIS_SRCS)): NXDK_CFLAGS += -I$(XBOX_OGG_DIR)/include \
	-I$(XBOX_VORBIS_DIR)/include -I$(XBOX_VORBIS_DIR)/lib
endif

SHADER_OBJS = \
	$(CURDIR)/code/renderernv2a/xbox_nv2a_vp.inl \
	$(CURDIR)/code/renderernv2a/xbox_nv2a_fp.inl

# nxdk's base USB library includes the XID driver.

# Native modules, paths relative to XBOX_MODULE_ROOT.
XBOX_MODULE_DIR = $(CURDIR)/$(OUTPUT_DIR)/modules
XBOX_MODULE_SHARED = qcommon/q_math.c qcommon/q_shared.c
XBOX_MODULE_LIBC = $(CURDIR)/code/sys/xbox_module_libc.c
XBOX_MODULE_CFLAGS = -DXBOX -DC_ONLY $(FLAVOR_DEFINES) -O2 -fno-exceptions \
	-include $(CURDIR)/code/sys/xbox_module.h

ifeq ($(FLAVOR),oa)
# OA 0.8.8 gamecode (OA gamecode repo, oa-0.8.8 branch) vendored in oa/.
# Lists from its Makefile, minus bg_lib.c, which is Q3_VM-only.
XBOX_MODULE_ROOT = $(CURDIR)/oa/code

qagame_SRCS = \
	game/g_main.c game/ai_chat.c game/ai_cmd.c game/ai_dmnet.c game/ai_dmq3.c \
