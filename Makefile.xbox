	$(CURDIR)/code/asm/snapvector.c 	$(wildcard $(CURDIR)/code/thirdparty/jpeg-9f/j*.c)

# nxdk supplies the Pentium III-safe ABI; XBOX is explicit so conditionals
# never depend on an incidental compiler macro.
NXDK_CFLAGS += -DXBOX -DIOQUAKE3_XBOX -DIOQUAKE3_XBOX_SHELL -DBOTLIB -DC_ONLY -O2 -ffunction-sections -fno-exceptions 	-DUSE_INTERNAL_JPEG -I$(CURDIR)/code/thirdparty/jpeg-9f \
	-I/usr/src/nxdk/lib/net/lwip/src/include \
	-I/usr/src/nxdk/lib/net/lwip/src/include/compat/posix
NXDK_NET = y
NXDK_USB_ENABLE_HID = y
SHADER_OBJS = \
	$(CURDIR)/code/renderernv2a/xbox_nv2a_vp.inl \
	$(CURDIR)/code/renderernv2a/xbox_nv2a_fp.inl

# nxdk's base USB library includes the XID driver.

# Native baseq3 modules, paths relative to code/ (lists from cmake/basegame.cmake).
XBOX_MODULE_DIR = $(CURDIR)/build_xbox/modules
XBOX_MODULE_SHARED = qcommon/q_math.c qcommon/q_shared.c sys/xbox_module_libc.c
XBOX_MODULE_CFLAGS = -DXBOX -DC_ONLY -O2 -fno-exceptions \
	-include $(CURDIR)/code/sys/xbox_module.h

qagame_SRCS = \
	game/g_main.c game/ai_chat.c game/ai_cmd.c game/ai_dmnet.c game/ai_dmq3.c \
	game/ai_main.c game/ai_team.c game/ai_vcmd.c game/bg_misc.c game/bg_pmove.c \
	game/bg_slidemove.c game/g_active.c game/g_arenas.c game/g_bot.c game/g_client.c \
	game/g_cmds.c game/g_combat.c game/g_items.c game/g_mem.c game/g_misc.c \
	game/g_missile.c game/g_mover.c game/g_session.c game/g_spawn.c game/g_svcmds.c \
	game/g_target.c game/g_team.c game/g_trigger.c game/g_utils.c game/g_weapon.c \
	game/g_syscalls.c $(XBOX_MODULE_SHARED)

cgame_SRCS = \
	cgame/cg_main.c game/bg_misc.c game/bg_pmove.c game/bg_slidemove.c \
	cgame/cg_consolecmds.c cgame/cg_draw.c cgame/cg_drawtools.c cgame/cg_effects.c \
	cgame/cg_ents.c cgame/cg_event.c cgame/cg_info.c cgame/cg_localents.c \
	cgame/cg_marks.c cgame/cg_particles.c cgame/cg_players.c cgame/cg_playerstate.c \
	cgame/cg_predict.c cgame/cg_scoreboard.c cgame/cg_servercmds.c cgame/cg_snapshot.c \
	cgame/cg_view.c cgame/cg_weapons.c cgame/cg_syscalls.c $(XBOX_MODULE_SHARED)

ui_SRCS = \
	q3_ui/ui_main.c game/bg_misc.c q3_ui/ui_addbots.c q3_ui/ui_atoms.c q3_ui/ui_cdkey.c \
	q3_ui/ui_cinematics.c q3_ui/ui_confirm.c q3_ui/ui_connect.c q3_ui/ui_controls2.c \
	q3_ui/ui_credits.c q3_ui/ui_demo2.c q3_ui/ui_display.c q3_ui/ui_gameinfo.c \
	q3_ui/ui_ingame.c q3_ui/ui_loadconfig.c q3_ui/ui_menu.c q3_ui/ui_mfield.c \
	q3_ui/ui_mods.c q3_ui/ui_network.c q3_ui/ui_options.c q3_ui/ui_playermodel.c \
	q3_ui/ui_players.c q3_ui/ui_playersettings.c q3_ui/ui_preferences.c q3_ui/ui_qmenu.c \
	q3_ui/ui_removebots.c q3_ui/ui_saveconfig.c q3_ui/ui_serverinfo.c q3_ui/ui_servers2.c \
	q3_ui/ui_setup.c q3_ui/ui_sound.c q3_ui/ui_sparena.c q3_ui/ui_specifyserver.c \
	q3_ui/ui_splevel.c q3_ui/ui_sppostgame.c q3_ui/ui_spskill.c q3_ui/ui_startserver.c \
	q3_ui/ui_team.c q3_ui/ui_teamorders.c q3_ui/ui_video.c ui/ui_syscalls.c \
	$(XBOX_MODULE_SHARED)

XBOX_MODULE_OBJS = $(XBOX_MODULE_DIR)/qagame.obj $(XBOX_MODULE_DIR)/cgame.obj \
	$(XBOX_MODULE_DIR)/ui.obj
CLEANRULES += clean-xbox-modules

NXDK_DIR ?= /usr/src/nxdk

include $(NXDK_DIR)/Makefile

# nxdk-link hard-codes a 64 KiB stack that lld keeps; Com_Init needs 1 MiB,
# so repeat the link recipe with a larger stack.
LD = lld -flavor link -subsystem:windows -fixed -base:0x00010000 -stack:1048576 -merge:.edata=.edataxb

# Args: module, module define, entry suffix (xbox_module.h). Internalize keeps only the two
# entry points global, so each module's q_shared/bg_misc/Com_Printf never clash in the link.
define XBOX_MODULE_RULES
$(1)_BC = $$(patsubst %.c,$$(XBOX_MODULE_DIR)/$(1)/%.bc,$$($(1)_SRCS))

$$(XBOX_MODULE_DIR)/$(1)/%.bc: $$(CURDIR)/code/%.c
	@mkdir -p $$(dir $$@)
	@echo "[ CC $(1) ] $$@"
	$$(VE)$$(CC) $$(XBOX_MODULE_CFLAGS) -D$(2) -MD -MP -MT '$$@' -MF '$$@.d' \
		-emit-llvm -c -o '$$@' '$$<'

$$(XBOX_MODULE_DIR)/$(1).obj: $$($(1)_BC)
	@echo "[ MODULE   ] $$@"
	$$(VE)llvm-link $$^ -o $$(XBOX_MODULE_DIR)/$(1).bc
	$$(VE)opt -passes=internalize,globaldce \
		-internalize-public-api-list=vmMain$(3),dllEntry$(3) \
		$$(XBOX_MODULE_DIR)/$(1).bc -o $$(XBOX_MODULE_DIR)/$(1).int.bc
	$$(VE)$$(CC) -O2 -Wno-unused-command-line-argument -c \
		$$(XBOX_MODULE_DIR)/$(1).int.bc -o $$@

-include $$($(1)_BC:.bc=.bc.d)
endef

$(eval $(call XBOX_MODULE_RULES,qagame,QAGAME,QAG))
$(eval $(call XBOX_MODULE_RULES,cgame,CGAME,CG))
$(eval $(call XBOX_MODULE_RULES,ui,UI,UI))

main.exe: $(XBOX_MODULE_OBJS)

.PHONY: clean-xbox-modules
clean-xbox-modules:
	$(VE)rm -rf $(XBOX_MODULE_DIR)

# This fragment is authored in nvparse syntax, so feed it directly to FP20.
$(CURDIR)/code/renderernv2a/xbox_nv2a_fp.inl: \
	$(CURDIR)/code/renderernv2a/xbox_nv2a_fp.ps | fp20compiler
	@echo "[ FP20     ] $@"
	$(FP20COMPILER) $< > $@
