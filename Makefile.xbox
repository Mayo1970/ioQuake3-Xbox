# Native OG Xbox target, independent of the host CMake build.
# No SDL, OpenGL, or desktop platform libraries enter this target.

# Flavor: q3 by default; `make -f Makefile.xbox oa` or OA=1 builds Open Arena,
# `ta` or TA=1 the Team Arena XBE (deployed as ta.xbe next to the q3 default.xbe).
ifeq ($(MAKECMDGOALS),oa)
OA := 1
endif
ifeq ($(MAKECMDGOALS),ta)
TA := 1
endif

ifeq ($(OA),1)
FLAVOR = oa
XBE_TITLE = "Open Arena"
OUTPUT_DIR = build_xbox_oa
FLAVOR_DEFINES = -DSTANDALONEOA
XBOX_ICON = $(CURDIR)/icons/oa/TitleImage.xbx
# Dashboards cache icons by Title ID; the cxbe default 0xFFFF0002 shows the q3 icon.
XBOX_TITLEID = 4F410001
else ifeq ($(TA),1)
FLAVOR = ta
XBE_TITLE = "ioQuake3 Team Arena"
OUTPUT_DIR = build_xbox_ta
FLAVOR_DEFINES = -DMISSIONPACK
# Launched by the q3 XBE, never listed by a dashboard, so it shares the q3 icon.
XBOX_ICON = $(CURDIR)/icons/q3/TitleImage.xbx
else
FLAVOR = q3
XBE_TITLE = ioQuake3
OUTPUT_DIR = build_xbox
FLAVOR_DEFINES =
XBOX_ICON = $(CURDIR)/icons/q3/TitleImage.xbx
endif

SRCS = \
	$(CURDIR)/code/sys/xbox_boot.c \
	$(CURDIR)/code/sys/sys_xbox.c \
	$(CURDIR)/code/sys/con_xbox.c \
	$(CURDIR)/code/sys/xbox_input.c \
	$(CURDIR)/code/sys/xbox_input_engine.c \
	$(CURDIR)/code/sys/xbox_snd.c \
	$(CURDIR)/code/sys/xbox_snd_engine.c \
