	$(CURDIR)/code/sys/xbox_diag.c \
	$(CURDIR)/code/sys/xbox_net.c \
	$(CURDIR)/code/sys/xbox_modules.c \
	$(CURDIR)/code/sys/xbox_launch.c \
	$(CURDIR)/code/renderernv2a/xbox_nv2a.c	$(CURDIR)/code/renderernv2a/xbox_nv2a_shader.c 	$(CURDIR)/code/renderernv2a/xbox_nv2a_model.c 	$(CURDIR)/code/renderernv2a/xbox_nv2a_world.c 	$(CURDIR)/code/renderernv2a/xbox_nv2a_sky.c 	$(CURDIR)/code/renderernv2a/xbox_nv2a_dxt.c 	$(CURDIR)/code/renderercommon/tr_image_tga.c 	$(CURDIR)/code/renderercommon/tr_image_jpg.c \
	$(CURDIR)/code/renderercommon/tr_noise.c \
	$(CURDIR)/code/sys/xbox_qcommon.c \
	$(CURDIR)/code/qcommon/cm_load.c \
