# Native OG Xbox target, independent of the host CMake build.
# No SDL, OpenGL, or desktop platform libraries enter this target.

XBE_TITLE = ioQuake3
OUTPUT_DIR = build_xbox

SRCS = \
	$(CURDIR)/code/sys/xbox_boot.c \
	$(CURDIR)/code/sys/sys_xbox.c \
	$(CURDIR)/code/sys/con_xbox.c \
	$(CURDIR)/code/sys/xbox_input.c \
	$(CURDIR)/code/sys/xbox_input_engine.c \
	$(CURDIR)/code/sys/xbox_snd.c \
	$(CURDIR)/code/sys/xbox_snd_engine.c \
	$(CURDIR)/code/sys/xbox_ref.c \
	$(CURDIR)/code/sys/xbox_diag.c \
	$(CURDIR)/code/renderernv2a/xbox_nv2a.c 	$(CURDIR)/code/renderernv2a/xbox_nv2a_shader.c 	$(CURDIR)/code/renderernv2a/xbox_nv2a_model.c 	$(CURDIR)/code/renderernv2a/xbox_nv2a_world.c 	$(CURDIR)/code/renderercommon/tr_image_tga.c 	$(CURDIR)/code/renderercommon/tr_image_jpg.c \
	$(CURDIR)/code/sys/xbox_qcommon.c \
	$(CURDIR)/code/qcommon/cm_load.c \
	$(CURDIR)/code/qcommon/cm_patch.c \
	$(CURDIR)/code/qcommon/cm_polylib.c \
	$(CURDIR)/code/qcommon/cm_test.c \
	$(CURDIR)/code/qcommon/cm_trace.c \
	$(CURDIR)/code/qcommon/cmd.c \
	$(CURDIR)/code/qcommon/common.c \
	$(CURDIR)/code/qcommon/cvar.c \
	$(CURDIR)/code/qcommon/files.c \
	$(CURDIR)/code/qcommon/huffman.c \
	$(CURDIR)/code/qcommon/ioapi.c \
	$(CURDIR)/code/qcommon/md4.c \
	$(CURDIR)/code/qcommon/md5.c \
	$(CURDIR)/code/qcommon/msg.c \
	$(CURDIR)/code/qcommon/net_chan.c \
	$(CURDIR)/code/qcommon/net_ip.c \
	$(CURDIR)/code/qcommon/q_shared.c \
	$(CURDIR)/code/qcommon/q_math.c \
	$(CURDIR)/code/qcommon/unzip.c \
	$(CURDIR)/code/qcommon/vm.c \
	$(CURDIR)/code/qcommon/vm_interpreted.c \
	$(CURDIR)/code/qcommon/vm_none.c \
	$(CURDIR)/code/client/cl_cgame.c \
	$(CURDIR)/code/client/cl_cin.c \
	$(CURDIR)/code/client/cl_console.c \
	$(CURDIR)/code/client/cl_input.c \
	$(CURDIR)/code/client/cl_keys.c \
	$(CURDIR)/code/client/cl_main.c \
	$(CURDIR)/code/client/cl_net_chan.c \
	$(CURDIR)/code/client/cl_parse.c \
	$(CURDIR)/code/client/cl_scrn.c \
	$(CURDIR)/code/client/cl_ui.c \
	$(CURDIR)/code/client/cl_avi.c \
	$(CURDIR)/code/client/snd_adpcm.c \
	$(CURDIR)/code/client/snd_dma.c \
	$(CURDIR)/code/client/snd_mem.c \
	$(CURDIR)/code/client/snd_mix.c \
	$(CURDIR)/code/client/snd_wavelet.c \
	$(CURDIR)/code/client/snd_main.c \
	$(CURDIR)/code/client/snd_codec.c \
	$(CURDIR)/code/client/snd_codec_wav.c \
	$(CURDIR)/code/server/sv_bot.c \
	$(CURDIR)/code/server/sv_ccmds.c \
	$(CURDIR)/code/server/sv_client.c \
	$(CURDIR)/code/server/sv_game.c \
	$(CURDIR)/code/server/sv_init.c \
	$(CURDIR)/code/server/sv_main.c \
	$(CURDIR)/code/server/sv_net_chan.c \
	$(CURDIR)/code/server/sv_snapshot.c \
	$(CURDIR)/code/server/sv_world.c \
	$(CURDIR)/code/asm/ftola.c \
	$(CURDIR)/code/asm/snapvector.c 	$(wildcard $(CURDIR)/code/thirdparty/jpeg-9f/j*.c)

# nxdk supplies the Pentium III-safe ABI; XBOX is explicit so conditionals
# never depend on an incidental compiler macro.
NXDK_CFLAGS += -DXBOX -DIOQUAKE3_XBOX -DIOQUAKE3_XBOX_SHELL -DBOTLIB -DC_ONLY -O2 -ffunction-sections -fno-exceptions 	-DUSE_INTERNAL_JPEG -I$(CURDIR)/code/thirdparty/jpeg-9f \
	-I/usr/src/nxdk/lib/net/lwip/src/include \
	-I/usr/src/nxdk/lib/net/lwip/src/include/compat/posix
NXDK_NET = y
SHADER_OBJS = \
	$(CURDIR)/code/renderernv2a/xbox_nv2a_vp.inl \
	$(CURDIR)/code/renderernv2a/xbox_nv2a_fp.inl

# nxdk's base USB library includes the XID driver.

NXDK_DIR ?= /usr/src/nxdk

include $(NXDK_DIR)/Makefile

# nxdk-link hard-codes a 64 KiB stack that lld keeps; Com_Init needs 1 MiB,
# so repeat the link recipe with a larger stack.
LD = lld -flavor link -subsystem:windows -fixed -base:0x00010000 -stack:1048576 -merge:.edata=.edataxb

# This fragment is authored in nvparse syntax, so feed it directly to FP20.
$(CURDIR)/code/renderernv2a/xbox_nv2a_fp.inl: \
	$(CURDIR)/code/renderernv2a/xbox_nv2a_fp.ps | fp20compiler
	@echo "[ FP20     ] $@"
	$(FP20COMPILER) $< > $@
