	game/bg_slidemove.c game/g_active.c game/g_arenas.c game/g_admin.c game/g_bot.c \
	game/g_client.c game/g_cmds.c game/g_cmds_ext.c game/g_combat.c game/g_items.c \
	game/bg_alloc.c game/g_fileops.c game/g_killspree.c game/g_misc.c game/g_missile.c \
	game/g_mover.c game/g_playerstore.c game/g_session.c game/g_spawn.c game/g_svcmds.c \
	game/g_svcmds_ext.c game/g_target.c game/g_team.c game/g_trigger.c game/g_unlagged.c \
	game/g_utils.c game/g_vote.c game/g_weapon.c game/g_syscalls.c $(XBOX_MODULE_SHARED)

cgame_SRCS = \
